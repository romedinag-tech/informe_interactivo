// Esquema relacional — Plataforma de informes interactivos con revisión ministerial.
// Modelo de contenido estructurado (Informe > Capítulo > Sección > Bloque) para que
// cada nodo tenga un ID estable al cual anclar observaciones contextuales.

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; el target RHEL para el runtime de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Autenticación y roles (RBAC)
// ─────────────────────────────────────────────────────────────

enum Role {
  CONSULTOR // acceso total de edición, gestión de respuestas
  REVISOR   // lectura del informe + permiso para comentar
  ADMIN     // administración de usuarios y asignaciones
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(REVISOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relaciones
  reportsCreated Report[]           @relation("ReportAuthor")
  assignments    ReportAssignment[]
  annotations    Annotation[]
  replies        AnnotationReply[]

  @@index([role])
}

// ─────────────────────────────────────────────────────────────
// Informe y su estructura de contenido
// ─────────────────────────────────────────────────────────────

enum ReportStatus {
  DRAFT      // en edición por el consultor
  IN_REVIEW  // publicado para revisión ministerial
  RESOLVED   // observaciones cerradas
  ARCHIVED
}

model Report {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  subtitle    String?
  status      ReportStatus @default(DRAFT)
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Diccionario de pronunciación de ElevenLabs derivado del glosario (caché).
  pronunciationDictId      String?
  pronunciationDictVersion String?
  pronunciationHash        String? // hash de las reglas; si cambia, se regenera

  createdBy   User               @relation("ReportAuthor", fields: [createdById], references: [id])
  chapters    Chapter[]
  annotations Annotation[]
  assignments ReportAssignment[]
  glossary    GlossaryTerm[]
  audios      AudioAsset[]
  maps        MapAsset[]
  figures     FigureAsset[]
  audit       AuditEvent[]

  @@index([status])
}

// Registro de auditoría INMUTABLE (append-only): quién hizo qué y cuándo.
// No se actualiza ni borra (salvo cascada al eliminar el informe). El nombre
// del actor se guarda desnormalizado como fotografía del momento.
model AuditEvent {
  id        String   @id @default(cuid())
  reportId  String
  actorId   String
  actorName String
  action    String // p.ej. "annotation.create", "annotation.status", "review.verdict"
  target    String? // id del objeto afectado (annotationId, etc.)
  summary   String // descripción legible en español
  detail    Json? // { from, to, note, severity, verdict, ... }
  createdAt DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId, createdAt])
}

// Geodata de un mapa navegable (zonas GeoJSON + capas + variables). Se carga
// bajo demanda (no infla la página del informe).
model MapAsset {
  id       String  @id @default(cuid())
  reportId String
  key      String // p.ej. "explorador"
  title    String?
  data     Json // { zonas: FeatureCollection, area, vars, capas... }

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, key])
  @@index([reportId])
}

// Imagen (figura estática del Word) de un bloque IMAGE. Bytes en la base,
// servida por ruta autenticada; no infla la página del informe.
model FigureAsset {
  id          String   @id @default(cuid())
  reportId    String
  blockId     String   @unique
  contentType String   @default("image/png")
  data        Bytes
  createdAt   DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// Control de acceso por informe: quién puede ver/comentar qué informe.
model ReportAssignment {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  role      Role // rol efectivo sobre ESTE informe (revisor, consultor, etc.)
  createdAt DateTime @default(now())

  // Marca cuándo el revisor envió formalmente sus observaciones al consultor.
  submittedAt DateTime?

  // Pronunciamiento consolidado del revisor sobre el entregable.
  verdict        ReviewVerdict @default(PENDING)
  verdictComment String?
  verdictAt      DateTime?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
}

model Chapter {
  id       String    @id @default(cuid())
  reportId String
  order    Int
  title    String
  number   String? // p.ej. "1", "2.1" (numeración editorial)

  report   Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sections Section[]
  audios   AudioAsset[]

  @@unique([reportId, order])
  @@index([reportId])
}

model Section {
  id        String @id @default(cuid())
  chapterId String
  order     Int
  title     String?

  // Acordeón: si la sección (p.ej. anexo metodológico denso) inicia colapsada.
  collapsedByDefault Boolean @default(false)

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  blocks  Block[]

  @@unique([chapterId, order])
  @@index([chapterId])
}

enum BlockType {
  HEADING
  PARAGRAPH
  TABLE
  CHART
  IMAGE
  CALLOUT
}

// Unidad atómica de contenido y ancla de las observaciones.
// `anchorKey` es un identificador corto y ESTABLE (no cambia aunque se reordene),
// que se expone en el DOM (data-anchor) para vincular la selección del revisor.
model Block {
  id        String    @id @default(cuid())
  sectionId String
  order     Int
  type      BlockType
  anchorKey String    @unique @default(cuid())

  // Contenido tipado según `type`:
  //  - HEADING/PARAGRAPH/CALLOUT: { text }
  //  - TABLE:   { columns: [...], rows: [[...]] }
  //  - CHART:   { kind: "bar"|"line"|..., data: [...], options: {...} }
  //  - IMAGE:   { src, alt, caption }
  content Json

  section     Section      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  annotations Annotation[]

  @@unique([sectionId, order])
  @@index([sectionId])
  @@index([anchorKey])
}

// ─────────────────────────────────────────────────────────────
// Observaciones contextuales (anotaciones)
// ─────────────────────────────────────────────────────────────

enum AnnotationStatus {
  OPEN        // Abierta: observación planteada por el revisor
  IN_PROGRESS // En proceso: el consultor la está atendiendo
  ANSWERED    // Respondida: el consultor respondió/contrapropuso, espera al revisor
  RESOLVED    // Resuelta: aceptada e implementada
  DISMISSED   // Descartada: rechazada con justificación
}

// Severidad de la observación (para priorizar y filtrar).
enum AnnotationSeverity {
  LOW    // Menor / recomendación
  MEDIUM // Importante
  HIGH   // Crítica (bloquea conformidad)
}

// Pronunciamiento consolidado del revisor sobre el entregable (estilo PR review).
enum ReviewVerdict {
  PENDING            // aún no se pronuncia
  CONFORME           // aprobado sin observaciones
  CON_OBSERVACIONES  // aprobado con observaciones a subsanar
  RECHAZADO          // rechazado
}

model Annotation {
  id       String @id @default(cuid())
  reportId String
  blockId  String // nodo de contenido al que se ancla (obligatorio)
  authorId String // revisor que la crea

  // Anclaje fino DENTRO del bloque (opcional). Si es null, la observación
  // aplica al bloque completo (tabla, gráfico, subtítulo).
  // Selectores redundantes (estilo W3C Web Annotation) para sobrevivir a
  // ediciones: cita exacta + contexto (prefix/suffix) + posición.
  quote      String? // TextQuoteSelector.exact
  prefix     String? // ~40 caracteres antes de la cita (desambigua repeticiones)
  suffix     String? // ~40 caracteres después de la cita
  rangeStart Int? // TextPositionSelector.start (offset dentro del texto del bloque)
  rangeEnd   Int? // TextPositionSelector.end

  body     String // el texto de la observación (dictado o tecleado)
  status   AnnotationStatus   @default(OPEN)
  severity AnnotationSeverity @default(MEDIUM)

  // Justificación al resolver o descartar (argumento de cierre). Se registra
  // también en el audit trail.
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  report  Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  block   Block             @relation(fields: [blockId], references: [id], onDelete: Cascade)
  author  User              @relation(fields: [authorId], references: [id])
  replies AnnotationReply[]

  @@index([reportId, status])
  @@index([blockId])
}

// Hilo de respuesta: contrapropuesta del consultor / réplica del revisor.
model AnnotationReply {
  id           String  @id @default(cuid())
  annotationId String
  authorId     String
  body         String
  isResolution Boolean @default(false) // marca la contrapropuesta que cierra la observación

  createdAt DateTime @default(now())

  annotation Annotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id])

  @@index([annotationId])
}

// ─────────────────────────────────────────────────────────────
// Glosario emergente (tooltips de términos técnicos: IMIV, SECTRA, EOD…)
// ─────────────────────────────────────────────────────────────

model GlossaryTerm {
  id         String  @id @default(cuid())
  reportId   String
  term       String // texto exacto que aparece en el informe (p.ej. "IMIV")
  definition String
  source     String? // norma/fuente de la definición (opcional)

  // Alias de pronunciación para la narración (p.ej. "IMIV" -> "ímiv"). Si es
  // null, la voz lo lee tal cual. Alimenta el diccionario de ElevenLabs.
  pronunciation String?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, term])
  @@index([reportId])
}

// ─────────────────────────────────────────────────────────────
// Caché de audio (narración por capítulo con ElevenLabs)
// ─────────────────────────────────────────────────────────────

model AudioAsset {
  id        String @id @default(cuid())
  reportId  String
  chapterId String

  // Clave de caché: hash del (texto + voz + modelo). Evita regenerar y re-pagar.
  textHash String
  voiceId  String
  model    String

  // El mp3 se guarda EN LA BASE (durable) → se genera una sola vez y no se
  // vuelve a llamar a ElevenLabs, incluso tras redeploys en serverless.
  data     Bytes?
  path     String? // (legado) ruta en disco si existiera
  mimeType String @default("audio/mpeg")
  bytes    Int    @default(0)

  createdAt DateTime @default(now())

  report  Report  @relation(fields: [reportId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([textHash])
  @@index([chapterId])
  @@index([reportId])
}

# --- Base de datos (PostgreSQL) ---
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/informes?schema=public"

# --- Auth.js / NextAuth ---
# Genera uno con: npx auth secret   (o)   openssl rand -base64 32
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL base de la app (en producción, el dominio real)
AUTH_URL="http://localhost:3000"

# --- Audio (ElevenLabs) — OPCIONAL ---
# Sin esta clave, el reproductor usa la voz del navegador (Web Speech) como respaldo.
# Consíguela en https://elevenlabs.io  →  Profile → API Key
ELEVENLABS_API_KEY=""
# Voz por defecto (id de la voz en tu cuenta de ElevenLabs)
ELEVENLABS_VOICE_ID="EXAVITQu4vr4xnSDxMaL"
# Modelo: eleven_multilingual_v2 (estable) | eleven_turbo_v2_5 (más rápido/barato)
ELEVENLABS_MODEL="eleven_multilingual_v2"
